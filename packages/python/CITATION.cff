cff-version: 1.2.0
message: "If you use this software, please cite it as below."
title: "TaxonBodyMassML"
abstract: >
  A machine-learning package for predicting species body mass from taxonomic
  identity, using an XGBoost model trained on published and unpublished data
  from across the tree of life.
note: "A manuscript describing this work is in preparation."
repository-code: "https://github.com/marknovak/TaxonBodyMassML"
url: "https://taxonbodymassml.github.io"
license: MIT
